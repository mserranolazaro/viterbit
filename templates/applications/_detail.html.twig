{#
    Everything on the detail page that can change while the AI works. Refreshed in place
    every few seconds while the application is pending (data-pending).
    "application" is null for a moment right after submitting: the read model is
    eventually consistent, so the page says so instead of answering 404.
#}
{% import 'ui/_macros.html.twig' as ui %}

{% if application is null %}
    <div data-pending data-page-title="New application" class="card mt-5">
        {{ ui.empty_state('sync', 'Application received', 'We are filing it. This page updates by itself in a moment.') }}
    </div>
{% else %}
{% set pending = application.status in ['received', 'enriching'] %}
<div data-page-title="{{ application.candidateName }}" {% if pending %}data-pending{% endif %}>
    <header class="page-header">
        <div class="flex items-center gap-4">
            <span class="avatar avatar--lg" aria-hidden="true">{{ ui.initials(application.candidateName) }}</span>
            <div>
                <p class="page-header__eyebrow">{{ application.positionTitle }}</p>
                <h1 class="page-header__title">{{ application.candidateName }}</h1>
            </div>
        </div>
        <div class="page-header__actions">{{ ui.status_chip(application.status) }}</div>
    </header>

    <div class="grid items-start gap-5 lg:grid-cols-12">
        <div class="grid gap-5 lg:col-span-8">
            <section class="card" aria-labelledby="screening">
                <div class="card__header">
                    <h2 class="card__title" id="screening">{{ ui.icon('auto_awesome') }} AI screening</h2>
                    {% if application.promptVersion %}<span class="chip chip--outline" title="Prompt that produced this result">{{ application.promptVersion }}</span>{% endif %}
                </div>
                <div class="card__body">
                    {% if application.status == 'enriched' %}
                        <div class="flex flex-col gap-5 sm:flex-row sm:items-center">
                            {{ ui.score_ring(application.score) }}
                            <div class="grid gap-1">
                                <p class="text-[12px] font-extrabold uppercase tracking-[.08em] text-subtle">Summary</p>
                                <p class="text-[15.5px] leading-relaxed">{{ application.summary }}</p>
                            </div>
                        </div>
                    {% elseif application.status == 'failed' %}
                        <div class="alert alert--error" role="alert">
                            {{ ui.icon('error') }}
                            <div class="alert__text">
                                <p class="font-bold">This CV could not be screened automatically.</p>
                                <p class="mt-1">Review it manually below; nothing is lost.</p>
                                {# The technical reason helps support, not recruiters: kept, but out of the way. #}
                                <details class="mt-2 text-[13px]">
                                    <summary class="cursor-pointer font-semibold">Technical details</summary>
                                    <p class="mt-1 opacity-80">{{ application.failureReason }}</p>
                                </details>
                            </div>
                        </div>
                    {% else %}
                        <div class="flex items-center gap-3 text-muted">
                            <span class="live-dot"></span>
                            <p>{{ application.status == 'enriching' ? 'Analysing the CV against the position requirements…' : 'Queued for analysis…' }} This page updates by itself.</p>
                        </div>
                    {% endif %}
                </div>
            </section>

            <section class="card" aria-labelledby="cv">
                <div class="card__header"><h2 class="card__title" id="cv">{{ ui.icon('description') }} CV as submitted</h2></div>
                <div class="card__body"><div class="cv-text" tabindex="0">{{ application.cvText }}</div></div>
            </section>
        </div>

        <aside class="grid gap-5 lg:col-span-4">
            <section class="card" aria-labelledby="candidate">
                <div class="card__header"><h2 class="card__title" id="candidate">{{ ui.icon('person_search') }} Candidate</h2></div>
                <div class="card__body details">
                    <div class="details__item">
                        <p class="details__label">Email</p>
                        <p class="details__value"><a href="mailto:{{ application.email }}">{{ application.email }}</a></p>
                    </div>
                    <div class="details__item">
                        <p class="details__label">Phone</p>
                        <p class="details__value">{% if application.phone %}<a href="tel:{{ application.phone|replace({' ': ''}) }}">{{ application.phone }}</a>{% else %}–{% endif %}</p>
                    </div>
                    {% if application.notes %}
                        <div class="details__item">
                            <p class="details__label">Notes</p>
                            <p class="details__value prose-text !font-medium !text-text">{{ application.notes }}</p>
                        </div>
                    {% endif %}
                </div>
            </section>

            <section class="card" aria-labelledby="timeline">
                <div class="card__header"><h2 class="card__title" id="timeline">{{ ui.icon('history') }} Timeline</h2></div>
                <div class="card__body details">
                    <div class="details__item">
                        <p class="details__label">Applied</p>
                        <p class="details__value">{{ ui.date(application.appliedAt) }}</p>
                    </div>
                    <div class="details__item">
                        <p class="details__label">Enriched</p>
                        <p class="details__value">{{ ui.date(application.enrichedAt) }}</p>
                    </div>
                    <div class="details__item">
                        <p class="details__label">Last update</p>
                        <p class="details__value">{{ ui.date(application.updatedAt) }}</p>
                    </div>
                </div>
            </section>
        </aside>
    </div>
</div>
{% endif %}
